# Modelo do .env — copie para `.env` e ajuste se o endereço da API mudar.
# Nada aqui é segredo: a API interna não tem autenticação de rede.

# Alvo da API interna usado pelo proxy do Vite em desenvolvimento (vite.config.js).
# Se não definir, o vite.config.js usa este mesmo endereço como padrão.
VITE_API_TARGET=http://192.168.255.6:5000

# Base usada pelo cliente HTTP (src/api/client.js).
# Vazio => requisições relativas ("/api/...") passam pelo proxy do Vite (sem CORS em dev).
# Em produção, se a SPA NÃO for servida atrás de um proxy, defina a URL completa aqui
# (ex.: http://192.168.255.6:5000) — o CORS já está liberado na API Flask.
VITE_API_BASE=
